[Unit]
Description=sanek325 Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/workspace/sanek325/telegram-bot
ExecStart=/root/workspace/sanek325/telegram-bot/.venv/bin/python -u bot.py
Restart=on-failure
RestartSec=5
# Log to journalctl: `journalctl -u sanek325-telegram-bot -f`
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
